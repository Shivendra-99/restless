{
  "name": "@restless/desktop",
  "productName": "Restless",
  "version": "0.4.0",
  "private": true,
  "description": "Local-first API + MCP client. No login, no cloud.",
  "license": "MIT",
  "homepage": "https://github.com/Shivendra-99/restless",
  "author": "Spryotech",
  "main": "dist/main.cjs",
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "node build-main.mjs",
    "build": "pnpm build:renderer && pnpm build:main",
    "dev": "pnpm build && electron .",
    "start": "electron .",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:linux": "pnpm build && electron-builder --linux",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "esbuild test/engine.verify.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-test/engine.verify.mjs --log-level=warning \"--banner:js=import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" && node dist-test/engine.verify.mjs ../.."
  },
  "dependencies": {},
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "@restless/core": "workspace:*",
    "@restless/ui": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "build": {
    "appId": "com.spryotech.restless",
    "productName": "Restless",
    "copyright": "Copyright © 2026 Shivendra-99 and Restless contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "Restless-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Restless-Setup-${version}.${ext}"
    },
    "appx": {
      "applicationId": "Restless",
      "displayName": "Restless",
      "backgroundColor": "#1b2230",
      "languages": [
        "en-US"
      ],
      "artifactName": "Restless-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "executableName": "restless",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "Restless-${version}-${arch}.${ext}"
    },
    "executableName": "restless",
    "publish": null
  },
  "desktopName": "restless.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shivendra-99/restless.git"
  }
}
