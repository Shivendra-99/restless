{
  "name": "restless",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first API + MCP client. No login, no cloud. Desktop (Mac/Windows/Linux) + Chrome/Edge extension.",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev:desktop": "pnpm --filter @restless/desktop dev",
    "build:desktop": "pnpm --filter @restless/desktop build",
    "dist:mac": "pnpm --filter @restless/desktop dist:mac",
    "dist:win": "pnpm --filter @restless/desktop dist:win",
    "build:extension": "pnpm --filter @restless/extension build",
    "test": "pnpm --filter @restless/core test",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm --filter @restless/core test && pnpm --filter @restless/desktop verify",
    "mcp:demo": "node scripts/test-mcp-server.mjs --http 3333",
    "api:demo": "node scripts/test-http-server.mjs 4545"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
